// 合併至既有 match /databases/{database}/documents；不可取代原專案規則。
function hanziGoogle() {
  return request.auth != null
    && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com';
}
function hanziAdmin() {
  return hanziGoogle() && request.auth.token.email == 'teacher.hsieh@gmail.com';
}
function hanziEnabled() {
  let accessPath = /databases/$(database)/documents/hanzi_notebook_access/$(request.auth.token.email);
  return !exists(accessPath) || get(accessPath).data.enabled == true;
}
match /hanzi_notebook_settings/curriculum {
  allow get: if true;
  allow create, update: if hanziAdmin()
    && request.resource.data.keys().hasAll(['publisher', 'grade', 'term', 'lesson'])
    && request.resource.data.keys().hasOnly(['publisher', 'grade', 'term', 'lesson'])
    && request.resource.data.publisher in ['南一', '康軒', '翰林']
    && request.resource.data.grade is int
    && request.resource.data.grade >= 1 && request.resource.data.grade <= 6
    && request.resource.data.term in ['上', '下']
    && request.resource.data.lesson is string
    && request.resource.data.lesson.size() > 0 && request.resource.data.lesson.size() <= 200;
  allow delete: if false;
}
match /hanzi_notebook_access/{email} {
  function validAccess() {
    return request.resource.data.keys().hasAll(['email', 'displayName', 'enabled'])
      && request.resource.data.keys().hasOnly(['email', 'displayName', 'enabled'])
      && request.resource.data.email == email
      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() <= 80
      && request.resource.data.enabled is bool;
  }
  allow get: if hanziAdmin() || (hanziGoogle() && request.auth.token.email == email);
  allow list: if hanziAdmin();
  allow create: if validAccess()
    && (email != 'teacher.hsieh@gmail.com' || request.resource.data.enabled == true)
    && (hanziAdmin() ||
    (hanziGoogle() && request.auth.token.email == email && request.resource.data.enabled == true));
  allow update: if hanziAdmin() && validAccess()
    && (email != 'teacher.hsieh@gmail.com' || request.resource.data.enabled == true);
  allow delete: if false;
}
match /hanzi_notebook_users/{uid}/collections/{collectionId} {
  function isOwner() {
    return hanziGoogle() && request.auth.uid == uid && hanziEnabled();
  }
  allow read: if isOwner();
  allow create, update: if isOwner()
    && request.resource.data.keys().hasAll(['schemaVersion', 'updatedAt', 'payload'])
    && request.resource.data.keys().hasOnly(['schemaVersion', 'updatedAt', 'payload'])
    && request.resource.data.schemaVersion == 1
    && request.resource.data.updatedAt is string
    && request.resource.data.updatedAt.size() <= 40
    && request.resource.data.payload is string
    && request.resource.data.payload.size() <= 700000;
  allow delete: if false;
}
