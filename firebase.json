{
  "hosting": [
    {
      "target": "zh-tw",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "/auth/schooliam/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/auth/schooliam/login",
          "run": {
            "serviceId": "zh-tw-structure-api",
            "region": "asia-east1"
          }
        },
        {
          "source": "/auth/schooliam/exchange",
          "run": {
            "serviceId": "zh-tw-structure-api",
            "region": "asia-east1"
          }
        },
        {
          "source": "/api/structure/**",
          "run": {
            "serviceId": "zh-tw-structure-api",
            "region": "asia-east1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "zh-tw-legacy",
      "public": "deploy/legacy-redirect",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://zh-tw.web.app/:path",
          "type": 301
        }
      ]
    }
  ]
}
